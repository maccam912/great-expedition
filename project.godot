config_version=5

[application]
config/name="The Great Expedition"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]
Session="*res://network/session.gd"
Rooms="*res://network/rooms.gd"

[network]
iroh/rendezvous_url="https://iroh-rendezvous.maccam912.workers.dev"
iroh/session_id="great-expedition/1"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.18, 0.42, 0.23, 1)

[editor_plugins]
enabled=PackedStringArray("res://addons/iroh_android/plugin.cfg")
